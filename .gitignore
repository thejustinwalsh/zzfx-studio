# Workbox runtime (copied by workbox-cli copyLibraries)
public/workbox-v*

# Audio render worker (bundled by esbuild, see "build:worker").
#
# Tracked until 2026-08-03, which cost a long debugging session. The bundle is
# the whole audio engine, so every change to song/effects/instruments makes the
# committed copy stale: its inputs changed across 15 commits and it was rebuilt
# in 4. Worse, being tracked meant any checkout, merge or reset restored the
# stale blob over a fresh build -- a reverted bug came back that way three
# times, silently, because this file plays audio rather than throwing.
# Generated by prestart/preweb/build:web, exactly like its sibling above.
#
# Pattern is **/ prefixed on purpose: a pattern containing a slash is anchored
# to this file's directory, so the bare `public/...` form above matches only a
# repo-root public/ and never apps/zzfx-studio/public/ where these actually land.
**/public/render-worker.js

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Turbo
.turbo

# package build outputs
packages/*/dist/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.claude/settings.local.json

# Local dev-server launch config
.claude/launch.json
